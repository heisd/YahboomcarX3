<?xml version="1.0" encoding="utf-8"?>
<!--
  Gazebo (Classic) simulation model for the Yahboomcar X3 (mecanum).
  Reuses the meshes shipped in yahboomcar_description and adds:
    - libgazebo_ros_planar_move  : holonomic /cmd_vel -> motion + /odom + TF
    - libgazebo_ros_ray_sensor   : 2D lidar on laser_link -> /scan
    - libgazebo_ros_imu_sensor   : IMU on imu_link        -> /imu/data
    - libgazebo_ros_camera       : RGB camera on camera_link -> /camera/*
  Frames are kept flat (no namespace) so they match the rest of the stack.
-->
<robot name="yahboomcar" xmlns:xacro="http://wiki.ros.org/xacro">

    <!-- Pitch (rad) applied to the camera sensor only (not the TF frame); a
         positive value tilts the optical axis downward for line following. -->
    <xacro:arg name="camera_pitch" default="0.0"/>
    <xacro:property name="camera_pitch" value="$(arg camera_pitch)"/>

    <xacro:property name="mesh_pkg" value="package://yahboomcar_description/meshes"/>

    <material name="Green"><color rgba="0 0.7 0 1"/></material>
    <material name="White"><color rgba="0.7 0.7 0.7 1"/></material>
    <material name="Black"><color rgba="0.1 0.1 0.1 1"/></material>

    <!-- ===================== Links / Joints ===================== -->
    <link name="base_footprint"/>

    <link name="base_link">
        <inertial>
            <origin xyz="0.00498197982182523 5.70233829969297E-05 -0.0121008098068578" rpy="0 0 0"/>
            <mass value="0.486218814966626"/>
            <inertia ixx="0.00196277727666921" ixy="2.50447049446755E-07" ixz="0.000140534767811098"
                     iyy="0.00457256033711368" iyz="2.68618064993882E-07" izz="0.00493927269870476"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="${mesh_pkg}/base_link_X3.STL"/></geometry>
            <material name="Green"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="${mesh_pkg}/base_link_X3.STL"/></geometry>
        </collision>
    </link>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0815" rpy="0 0 0"/>
    </joint>

    <link name="imu_link"/>
    <joint name="base_imu" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="-0.06 0.01 0.01" rpy="0 3.1415 1.5707"/>
    </joint>

    <!-- wheel macro -->
    <xacro:macro name="wheel" params="name mesh xyz rpy *inertial">
        <link name="${name}">
            <xacro:insert_block name="inertial"/>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><mesh filename="${mesh_pkg}/${mesh}.STL"/></geometry>
                <material name="Black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry><mesh filename="${mesh_pkg}/${mesh}.STL"/></geometry>
            </collision>
        </link>
        <joint name="${name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <parent link="base_link"/>
            <child link="${name}"/>
            <axis xyz="0 0 1"/>
            <limit effort="100" velocity="20"/>
        </joint>
    </xacro:macro>

    <xacro:wheel name="front_right_wheel" mesh="front_right_wheel_X3" xyz="0.08 -0.0845 -0.0389" rpy="-1.5703 0 3.14159">
        <inertial>
            <origin xyz="1.9051E-06 -2.3183E-07 -0.00064079" rpy="0 0 0"/>
            <mass value="0.051532"/>
            <inertia ixx="1.4595E-05" ixy="-4.3975E-10" ixz="4.415E-10"
                     iyy="1.4594E-05" iyz="-1.7476E-09" izz="2.4264E-05"/>
        </inertial>
    </xacro:wheel>
    <xacro:wheel name="front_left_wheel" mesh="front_left_wheel_X3" xyz="0.08 0.084492 -0.0389" rpy="1.5703 0 0">
        <inertial>
            <origin xyz="2.3728E-06 -9.4228E-07 0.00064068" rpy="0 0 0"/>
            <mass value="0.051543"/>
            <inertia ixx="1.4597E-05" ixy="-4.7945E-10" ixz="-2.4786E-10"
                     iyy="1.4598E-05" iyz="1.7972E-09" izz="2.4267E-05"/>
        </inertial>
    </xacro:wheel>
    <xacro:wheel name="back_right_wheel" mesh="back_right_wheel_X3" xyz="-0.08 -0.0845 -0.03946" rpy="-1.57 0 3.14159">
        <inertial>
            <origin xyz="-1.75924169923403E-06 1.28388821071107E-06 -0.000590549296238266" rpy="0 0 0"/>
            <mass value="0.051540174053366"/>
            <inertia ixx="1.45974152250002E-05" ixy="1.94850559178397E-10" ixz="-1.61846387282284E-09"
                     iyy="1.4596501955693E-05" iyz="-6.27904057423818E-10" izz="2.42663091380451E-05"/>
        </inertial>
    </xacro:wheel>
    <xacro:wheel name="back_left_wheel" mesh="back_left_wheel_X3" xyz="-0.08 0.084492 -0.03954" rpy="1.5703 0 0">
        <inertial>
            <origin xyz="-4.01213085227115E-07 2.04910264598596E-06 0.000590775697051377" rpy="0 0 0"/>
            <mass value="0.0515309299357028"/>
            <inertia ixx="1.45942986129926E-05" ixy="-3.19787215398093E-10" ixz="1.74943062058915E-09"
                     iyy="1.45948727598913E-05" iyz="1.61769812110049E-10" izz="2.4263683888153E-05"/>
        </inertial>
    </xacro:wheel>

    <link name="laser_link">
        <inertial>
            <origin xyz="-0.0176558922685589 0.000671805271544437 0.0219302095894866" rpy="0 0 0"/>
            <mass value="0.0483909504209895"/>
            <inertia ixx="1.58456966399128E-05" ixy="-4.23913983850005E-07" ixz="-2.09597897904374E-07"
                     iyy="3.89262522903605E-05" iyz="3.24809725932687E-07" izz="4.86230801106223E-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="${mesh_pkg}/laser_link.STL"/></geometry>
            <material name="White"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="${mesh_pkg}/laser_link.STL"/></geometry>
        </collision>
    </link>
    <joint name="laser_joint" type="fixed">
        <origin xyz="0.0435 5.25826986680105E-05 0.11" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="laser_link"/>
    </joint>

    <link name="camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.01"/>
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="${mesh_pkg}/camera_link.STL"/></geometry>
            <material name="White"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="${mesh_pkg}/camera_link.STL"/></geometry>
        </collision>
    </link>
    <joint name="camera_joint" type="fixed">
        <origin xyz="0.057105 1.7948E-05 0.03755" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>

    <!-- optical frame so camera data follows REP-103 (z forward) -->
    <link name="camera_optical_link"/>
    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
        <parent link="camera_link"/>
        <child link="camera_optical_link"/>
    </joint>

    <!-- ===================== Gazebo materials / friction ===================== -->
    <gazebo reference="base_link"><material>Gazebo/Green</material></gazebo>
    <gazebo reference="laser_link"><material>Gazebo/DarkGrey</material></gazebo>
    <gazebo reference="camera_link"><material>Gazebo/DarkGrey</material></gazebo>

    <xacro:macro name="wheel_gazebo" params="name">
        <gazebo reference="${name}">
            <material>Gazebo/FlatBlack</material>
            <!-- planar_move drives the body directly; keep wheel friction low so
                 ground contact only supplies vertical support and does not fight it -->
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <kp>1000000.0</kp>
            <kd>10.0</kd>
        </gazebo>
    </xacro:macro>
    <xacro:wheel_gazebo name="front_right_wheel"/>
    <xacro:wheel_gazebo name="front_left_wheel"/>
    <xacro:wheel_gazebo name="back_right_wheel"/>
    <xacro:wheel_gazebo name="back_left_wheel"/>

    <!-- ===================== Mecanum (holonomic) base controller ===================== -->
    <gazebo>
        <plugin name="planar_move_controller" filename="libgazebo_ros_planar_move.so">
            <ros>
                <namespace>/</namespace>
                <remapping>cmd_vel:=cmd_vel</remapping>
                <remapping>odom:=odom</remapping>
            </ros>
            <update_rate>30</update_rate>
            <publish_rate>30</publish_rate>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
            <covariance_x>0.0001</covariance_x>
            <covariance_y>0.0001</covariance_y>
            <covariance_yaw>0.01</covariance_yaw>
        </plugin>
    </gazebo>

    <!-- ===================== 2D Lidar ===================== -->
    <gazebo reference="laser_link">
        <sensor name="laser_sensor" type="ray">
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <always_on>true</always_on>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159265</min_angle>
                        <max_angle>3.14159265</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>8.0</max>
                    <resolution>0.015</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <namespace>/</namespace>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>laser_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <!-- ===================== IMU ===================== -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <namespace>/</namespace>
                    <remapping>~/out:=imu/data</remapping>
                </ros>
                <frame_name>imu_link</frame_name>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
            </plugin>
        </sensor>
    </gazebo>

    <!-- ===================== RGB camera ===================== -->
    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <pose>0 0 0 0 ${camera_pitch} 0</pose>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>false</visualize>
            <camera name="rgb_camera">
                <horizontal_fov>1.085595</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>20.0</far>
                </clip>
            </camera>
            <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                <ros>
                    <namespace>/</namespace>
                </ros>
                <camera_name>camera</camera_name>
                <frame_name>camera_optical_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>
