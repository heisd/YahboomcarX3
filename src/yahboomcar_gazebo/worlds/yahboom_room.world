<?xml version="1.0" ?>
<!--
  Yahboomcar X3 demo room.

  Uses Gazebo's bundled models (sun, ground_plane) plus inline primitive
  geometry for the walls and furniture. Primitives are used on purpose: the
  legacy online model database (models.gazebosim.org) that served models like
  cafe_table / bookshelf / grey_wall is no longer available, so a world built
  from those `model://` includes will not load on a stock Gazebo Classic 11.
  Inline boxes/cylinders always work offline.
-->
<sdf version="1.6">
  <world name="yahboom_room">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ===== 6m x 6m perimeter walls ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.15 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6 0.15 0.6</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.15 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6 0.15 0.6</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>3 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 6 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 6 0.6</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 6 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 6 0.6</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== a little static furniture ===== -->
    <model name="table">
      <static>true</static>
      <pose>2 1.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.4</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
          <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.5 0.3 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar">
      <static>true</static>
      <pose>-2 1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.2 0.45 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

  </world>
</sdf>
