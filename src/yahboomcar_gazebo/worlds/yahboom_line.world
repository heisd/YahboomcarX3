<?xml version="1.0" ?>
<!--
  Line-following demo world. A yellow line is laid on the floor as a strip of
  short, flat, *visual-only* boxes (no collision, so the robot rolls over it).
  Generated from y = 0.9*sin(pi*x/5): a gentle curve out and back, which
  exercises the line_track PID. Pair with camera_pitch:=~0.6 so the X3 camera
  looks down at the line.
-->
<sdf version="1.6">
  <world name="yahboom_line">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

